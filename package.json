{
  "name": "aidoo-whisper-lite",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && npm run test:assistant && npm run check:structure && npm run check:i18n && npm run check:release-config && npm run check:macos-dependencies && npm run check:wakeword && npm run check:website",
    "test:assistant": "node --test scripts/test-assistant-command.mjs scripts/test-aidoo-live-tools.mjs scripts/test-live-inactivity.mjs scripts/test-live-microphone.mjs",
    "check:structure": "python3 scripts/check-source-layout.py",
    "check:i18n": "node scripts/check-i18n-errors.mjs",
    "check:release-config": "python3 scripts/check-release-config.py",
    "check:macos-dependencies": "python3 scripts/check-macos-dependencies.py",
    "check:wakeword": "python3 scripts/check-wakeword-model.py",
    "check:website": "python3 scripts/check-website.py",
    "tauri": "tauri",
    "bundle:mac": "tauri build --target aarch64-apple-darwin --bundles app,dmg --ci -- --locked",
    "notarize:mac": "bash scripts/notarize-mac.sh",
    "release:mac": "bash scripts/release-mac.sh",
    "audit:mac": "bash scripts/audit-mac-release.sh",
    "package:website": "python3 scripts/package-website-release.py",
    "verify:website": "python3 scripts/package-website-release.py --verify"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
