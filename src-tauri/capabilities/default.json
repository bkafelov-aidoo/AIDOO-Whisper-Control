{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AIDOO Whisper Lite desktop permissions",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://platform.openai.com/api-keys" },
        { "url": "https://github.com/bkafelov-aidoo/Aidoo-Whisper/issues" }
      ]
    },
    "autostart:default"
  ]
}
