{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "AIDOO Whisper Lite main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://platform.openai.com/api-keys" },
        { "url": "https://github.com/bkafelov-aidoo/Aidoo-Whisper/issues" }
      ]
    },
    "autostart:default"
  ]
}
